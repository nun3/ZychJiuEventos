# Valores publicos obtidos em Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://kfvypacjzlzwwblsbpwj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL publica da aplicacao, usada em redirecionamentos de autenticacao.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Go-live assistido: true bloqueia emissão Asaas. Reserva e baixa manual continuam.
PAYMENTS_MANUAL_ONLY=true

# Go-live assistido: UUID da organização visível nas superfícies públicas.
# Vazio = catálogo multi-organização. Inválido = nenhum evento público.
PUBLIC_ORGANIZATION_ID=

# Sprint 6: somente no servidor, nunca prefixar com NEXT_PUBLIC_.
# Sandbox usa variáveis sem PRODUCTION.
# Production usa exclusivamente variáveis PRODUCTION.
# Não reutilizar wallet ou token entre ambientes.
ASAAS_ENVIRONMENT=sandbox
ASAAS_SANDBOX_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_SPLIT_RECIPIENT_WALLET_ID=
ASAAS_PRODUCTION_API_KEY=
ASAAS_PRODUCTION_WEBHOOK_TOKEN=
ASAAS_PRODUCTION_SPLIT_RECIPIENT_WALLET_ID=
ASAAS_SPLIT_RECIPIENT_PERCENT=50
PLATFORM_SETTLEMENT_ASAAS_ENABLED=false
# Para a futura persistencia de webhooks. Nunca usar no navegador.
SUPABASE_SECRET_KEY=
