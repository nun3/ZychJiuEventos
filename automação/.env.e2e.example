# Copie para .env.e2e. Nunca versione o arquivo preenchido.
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=

# Conta autenticada sem vinculo com organizacao, usada no teste de negacao.
E2E_UNAUTHORIZED_EMAIL=
E2E_UNAUTHORIZED_PASSWORD=

# Ative conscientemente para criar massa unica no Sandbox.
E2E_ALLOW_WRITES=false

# Habilita POST e limpeza de cobranças fictícias somente no Asaas Sandbox.
E2E_ALLOW_ASAAS=false
E2E_ASAAS_WEBHOOK_TOKEN=
