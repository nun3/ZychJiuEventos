{
  "name": "automacao-meu-camp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test:unit": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register --test tests/*.test.ts",
    "test:bdd": "bddgen && playwright test",
    "test:payments": "bddgen && playwright test --grep @payments",
    "test:payments:asaas": "bddgen && E2E_ALLOW_ASAAS=true playwright test --grep @asaas",
    "test:payments:asaas:boleto": "bddgen && E2E_ALLOW_ASAAS=true playwright test --grep @asaas_boleto",
    "test:payments:asaas:pix": "bddgen && E2E_ALLOW_ASAAS=true playwright test --grep @asaas_pix",
    "test:payments:webhook": "bddgen && playwright test --grep @webhook",
    "test:payments:manual": "bddgen && playwright test --grep @manual-settlement",
    "test:generate": "bddgen",
    "test:smoke": "bddgen && playwright test --grep @smoke",
    "test:write": "bddgen && playwright test --grep @write",
    "test:checagem": "bddgen && playwright test --grep @sprint7",
    "cleanup:e2e:dry-run": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/e2e-cleanup.ts",
    "cleanup:e2e": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/e2e-cleanup.ts --execute",
    "mc-sim:bootstrap": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/mc-sim-bootstrap.ts",
    "mc-sim:bootstrap:owner-session": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/mc-sim-bootstrap.ts --owner-session",
    "mc-sim:participants": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/mc-sim-runbook.ts participants",
    "mc-sim:registrations": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/mc-sim-runbook.ts registrations",
    "mc-sim:settle": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/mc-sim-runbook.ts settle",
    "mc-sim:checking": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/mc-sim-runbook.ts checking",
    "mc-sim:change-request": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/mc-sim-runbook.ts change-request",
    "mc-sim:review": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/mc-sim-runbook.ts review",
    "mc-sim:lock": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/mc-sim-runbook.ts lock",
    "mc-sim:verify": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/mc-sim-verify.ts",
    "mc-sim:ui-smoke": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/mc-sim-ui-smoke.ts",
    "mc-sim:r2:bootstrap": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/mc-sim-r2-bootstrap.ts",
    "mc-sim:r2:participants": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/mc-sim-r2-runbook.ts participants",
    "mc-sim:r2:registrations": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/mc-sim-r2-runbook.ts registrations",
    "mc-sim:r2:settle": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/mc-sim-r2-runbook.ts settle",
    "mc-sim:r2:checking": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/mc-sim-r2-runbook.ts checking",
    "mc-sim:r2:request": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/mc-sim-r2-runbook.ts request",
    "mc-sim:r2:reject": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/mc-sim-r2-runbook.ts reject",
    "mc-sim:r2:request-again": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/mc-sim-r2-runbook.ts request-again",
    "mc-sim:r2:approve": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/mc-sim-r2-runbook.ts approve",
    "mc-sim:r2:lock": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/mc-sim-r2-runbook.ts lock",
    "mc-sim:r2:verify": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/mc-sim-r2-verify.ts",
    "mc-sim:r2:ui-smoke": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/mc-sim-r2-ui-smoke.ts",
    "mc-sim:sprint8": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/mc-sim-sprint8.ts",
    "mc-sim:sprint9": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/mc-sim-sprint9.ts",
    "test:brackets:public": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/sprint8-public-brackets-smoke.ts",
    "test:brackets:results": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/sprint8-results-ui-smoke.ts",
    "test:schedule": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/sprint9-schedule-ui-smoke.ts",
    "test:schedule:public": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/sprint9-public-schedule-smoke.ts",
    "test:checklist": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/sprint10-group-checklist-smoke.ts",
    "test:duration": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' node --require ts-node/register scripts/sprint11-fight-duration-smoke.ts",
    "test:transitions": "bddgen && playwright test --grep @transitions"
  },
  "dependencies": {
    "playwright": "1.51.1"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "playwright-bdd": "8.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2"
  }
}
