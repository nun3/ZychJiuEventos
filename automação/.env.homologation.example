# Template para homologação num Supabase INDEPENDENTE de zigjiu (nunca produção).
# Copie para automação/.env.homologation (já ignorado pelo .gitignore de automação) e preencha
# com as credenciais do projeto DESCARTÁVEL criado para este fim.
#
# Nomes de variável próprios (HOMOLOG_*), para nunca herdar por engano as credenciais de
# produção de .env.local (NEXT_PUBLIC_SUPABASE_URL / SUPABASE_SECRET_KEY).
#
# Ver docs/releases/EVENT-READINESS.md § Homologação independente para o passo a passo completo
# de provisionamento e aplicação de schema antes de rodar os scripts que leem este arquivo.

HOMOLOG_SUPABASE_URL=
HOMOLOG_SUPABASE_SERVICE_ROLE_KEY=

# Precisa ser "true", de propósito, para liberar qualquer escrita neste projeto independente.
HOMOLOG_ALLOW_WRITES=false
