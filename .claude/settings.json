{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(!*.example)",
      "Read(automação/.env.e2e)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(id_ecdsa)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(credentials.json)",
      "Read(~/.ssh/**)"
    ],
    "allow": [
      "mcp__supabase__list_migrations",
      "mcp__supabase__get_advisors"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Bash(npx supabase *)",
      "Bash(supabase *)",
      "mcp__vercel__*",
      "mcp__supabase__execute_sql",
      "mcp__supabase__apply_migration"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
